pkgname=elsewhen
pkgver=0.5.0
pkgrel=1
pkgdesc='Local-first personal event recorder with global hotkey capture'
url='https://github.com/zjinys/elsewhen'
arch=('x86_64')
license=('AGPL3')
# Flutter UI needs gtk3; the native sync keystore plugin also links libsecret.
# tray_manager pulls in libayatana-appindicator -> libayatana-indicator -> ayatana-ido;
# pacman does not resolve transitive .so deps of the bundle's plugins, list them all.
depends=('gtk3' 'libsecret' 'libayatana-appindicator' 'libayatana-indicator' 'ayatana-ido')
# 容器内 makepkg.conf 默认开 debug，会产出一个几乎为空的 elsewhen-debug 包；关掉。
options=('!debug')
package() {
  install -d "$pkgdir/usr/lib/elsewhen"
  cp -a "$startdir/../../ui/build/linux/x64/release/bundle/." "$pkgdir/usr/lib/elsewhen/"
  install -d "$pkgdir/usr/bin"
  printf '%s\n' '#!/bin/sh' 'export LD_LIBRARY_PATH="/usr/lib/elsewhen/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"' 'exec /usr/lib/elsewhen/elsewhen_ui "$@"' > "$pkgdir/usr/bin/elsewhen"
  chmod 755 "$pkgdir/usr/bin/elsewhen"
  install -Dm644 "$startdir/io.github.elsewhen.Elsewhen.desktop" "$pkgdir/usr/share/applications/io.github.elsewhen.Elsewhen.desktop"
  if [ -f "$startdir/../../assets/brand/elsewhen-icon-v2-256.png" ]; then
    install -Dm644 "$startdir/../../assets/brand/elsewhen-icon-v2-256.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/io.github.elsewhen.Elsewhen.png"
  fi
}
