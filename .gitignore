# Rust
/target/
**/*.rs.bk
*.pdb

# Build outputs (cavy-style packaging)
/dist/
packaging/linux/pkg/
packaging/linux/src/
*.pkg.tar.*
*.pkg.tar.zst

# Local data (SQLite, runtime state)
.data/
*.db
*.db-*
*.sqlite
*.sqlite3

# Env
.env
.env.*

# 不提交的素材文件（下载的视频/音频/图片/转录稿等）
# 目录与 README 提交，里面的内容一律不提交
/materials/*
!/materials/
!/materials/README.md

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# FVM Version Cache
.fvm/
.workbuddy/
# 参考素材目录
/ref/
ui/rustLibs/

# 排查期临时产物（误留在仓库根/UI 目录）
/cargo_test.txt
/ui/flutter_*.png
# Flutter/Gradle 构建目录
ui/android/build/
ui/build/
ui/linux/flutter/ephemeral/
# Claude Code 本地状态与 agent 临时工作树（均不应入库；
# worktrees/ 是内嵌 git 仓库，提交会产生 submodule 式悬空引用）
.claude/settings.local.json
.claude/worktrees/
