#!/usr/bin/env bash
# release-tag —— 发版打 tag 一条龙：更新版本信息 → 提交 → 合并 main → 推送 → 打 tag。
#
# 用法:
#   release-tag.sh <version>              # 例: release-tag.sh 0.8.0
#   release-tag.sh <version> --no-push    # 只本地提交与打 tag，不推送
#   release-tag.sh <version> --message "说明"   # 自定义 tag 附注首行之外说明
#
# 更新的版本文件（存在才改）:
#   Cargo.toml            version = "X.Y.Z"
#   Cargo.lock            elsewhen 包的 version（保持锁与 manifest 一致）
#   ui/pubspec.yaml       version: X.Y.Z+<build>，build = 次版本*10 + 补丁号
#                         （0.5.1→51、0.7.0→70 的既有惯例）
#   packaging/linux/PKGBUILD  pkgver=X.Y.Z（本地 makepkg 兜底；CI 发版以 tag 为准）
#
# 流程:
#   1. 校验版本号合法、tag v<version> 本地/远端都不存在、工作区可提交
#   2. 只把上述版本文件单独提交（不碰工作区里其它进行中的改动）
#   3. 要求 main 是当前分支祖先（否则报错提示先合并），main --ff-only 到位
#   4. push main → 回原分支 → push 原分支（尽力而为）→ 打 annotated tag → push tag
#   5. 打印 tag 附注与 CI 提示（release.yml 会在 tag 构建全平台产物）
set -euo pipefail

usage() { echo "用法: release-tag <version> [--no-push] [--message \"说明\"]" >&2; exit 2; }

VER=""
NO_PUSH=0
USER_MSG=""
while [ $# -gt 0 ]; do
  case "$1" in
    --no-push) NO_PUSH=1; shift ;;
    --message) [ $# -ge 2 ] || usage; USER_MSG="$2"; shift 2 ;;
    -h|--help) usage ;;
    -*) echo "未知参数: $1" >&2; usage ;;
    *) [ -z "$VER" ] || usage; VER="$1"; shift ;;
  esac
done
[ -n "$VER" ] || usage
echo "$VER" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$' || { echo "✗ 版本号必须是 X.Y.Z 数字形式: $VER" >&2; exit 1; }

TAG="v$VER"
BUILD=$(( $(echo "$VER" | cut -d. -f2) * 10 + $(echo "$VER" | cut -d. -f3) ))
MSG="${USER_MSG:-$TAG 发布}"

# ── 定位仓库 ────────────────────────────────────────────────────────────────
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "✗ 不在 git 仓库内" >&2; exit 1; }
cd "$ROOT"
BRANCH="$(git branch --show-current)"
[ -n "$BRANCH" ] || { echo "✗ 处于 detached HEAD，请先切到工作分支" >&2; exit 1; }
echo "仓库: $ROOT（分支 $BRANCH）→ 版本 $VER（build +$BUILD）"

# ── 预检 ────────────────────────────────────────────────────────────────────
if git rev-parse -q --verify "refs/tags/$TAG" >/dev/null; then
  echo "✗ 本地已存在 tag $TAG，先删除或换版本号" >&2; exit 1
fi
if [ "$NO_PUSH" -eq 0 ]; then
  if git ls-remote --tags origin "refs/tags/$TAG" | grep -q .; then
    echo "✗ 远端已存在 tag $TAG" >&2; exit 1
  fi
  if ! git merge-base --is-ancestor main HEAD 2>/dev/null; then
    echo "✗ main 不是当前分支的祖先，无法 fast-forward；先把 main 合进当前分支再打版" >&2; exit 1
  fi
fi

VERSION_FILES=()
seds() {
  # $1=文件 $2=sed 表达式；文件存在才处理并登记
  local file="$1" expr="$2"
  [ -f "$file" ] || return 0
  sed -i "$expr" "$file"
  VERSION_FILES+=("$file")
}

seds "Cargo.toml"            "s/^version = .*/version = \"$VER\"/"
seds "Cargo.lock"            '/^name = "elsewhen"$/,/^version = /s/^version = .*/version = "'"$VER"'"/'
seds "ui/pubspec.yaml"       "s/^version: .*/version: $VER+$BUILD/"
seds "packaging/linux/PKGBUILD" "s/^pkgver=.*/pkgver=$VER/"

if [ ${#VERSION_FILES[@]} -eq 0 ]; then
  echo "✗ 没找到任何版本文件（Cargo.toml / ui/pubspec.yaml / PKGBUILD）" >&2; exit 1
fi

# 核对写入结果，防 sed 静默失配
grep -q "^version = \"$VER\"" Cargo.toml 2>/dev/null || { echo "✗ Cargo.toml 版本未写入" >&2; exit 1; }
grep -q "^version: $VER+$BUILD" ui/pubspec.yaml 2>/dev/null || { echo "✗ pubspec 版本未写入" >&2; exit 1; }
echo "版本文件已更新: ${VERSION_FILES[*]}"

# ── 提交版本文件 ────────────────────────────────────────────────────────────
git add -- "${VERSION_FILES[@]}"
if git diff --cached --quiet; then
  echo "• 版本文件无变化，跳过提交"
else
  git commit -m "chore(release): 版本升至 $VER"
fi
BUMP_SHA="$(git rev-parse --short HEAD)"

# ── 合并 main 并推送 ────────────────────────────────────────────────────────
if [ "$BRANCH" != "main" ]; then
  git checkout main
  git merge --ff-only "$BRANCH"
fi
if [ "$NO_PUSH" -eq 0 ]; then
  git push origin main
  [ "$BRANCH" != "main" ] && { git checkout "$BRANCH" && git push origin "$BRANCH" 2>/dev/null || true; }
else
  echo "• --no-push：跳过推送"
fi

# ── 打 tag ──────────────────────────────────────────────────────────────────
PREV="$(git describe --tags --abbrev=0 2>/dev/null || true)"
NOTES="$MSG"
if [ -n "$PREV" ] && [ "$PREV" != "$TAG" ]; then
  NOTES="$NOTES

$(git log --oneline "$PREV..$BUMP_SHA" | sed 's/^/- /')"
fi
git tag -a "$TAG" -m "$NOTES"
echo "已打 tag $TAG（指向 $BUMP_SHA）"

if [ "$NO_PUSH" -eq 0 ]; then
  git push origin "$TAG"
  echo "✓ 完成：$TAG 已推送，release.yml 将自动构建全平台产物"
  echo "  进度: https://github.com/$(git remote get-url origin | sed 's#.*github.com[:/]##; s#\.git$##')/actions"
else
  echo "✓ 完成：本地已打 tag $TAG；推送时执行: git push origin main \"$TAG\""
fi
