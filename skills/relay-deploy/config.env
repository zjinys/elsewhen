# relay 部署配置 —— 只改这个文件，不要改脚本里的常量。
#
# 取值会被 scripts/deploy.sh 与 scripts/verify.sh 直接 source（纯 KEY=VALUE，
# 不要写 `export`、不要用空格包围 `=`，不要加引号以外的修饰）。
#
# 敏感信息（密码/私钥路径）不要写在这里：放到同目录的 config.local.env，
# 它已在 .gitignore 里，脚本会在这份文件之后覆盖加载。

# ─── 服务器 ─────────────────────────────────────────────────────────────
# relay 跑在 Tower 上（同一台机器还跑着 Gitea，端口 30000）。
RELAY_HOST=192.168.101.116

# 只能用 root：pp / tower / admin / zjinys 都是 publickey 拒绝，
# 只有 root 的公钥在这台机器上。别改成自己的用户名然后怀疑网络。
RELAY_SSH_USER=root

# 非 22 端口时填，例如 RELAY_SSH_PORT=2222
RELAY_SSH_PORT=22

# ─── 容器 ───────────────────────────────────────────────────────────────
RELAY_CONTAINER=elsewhen-relay
RELAY_IMAGE=elsewhen-relay

# 对外端口（客户端中继 URL 就是 http://$RELAY_HOST:$RELAY_PORT）
RELAY_PORT=8787

# 宿主机上的信箱数据目录（**必须保留**：配对关系与在途信封都在这里）。
# 删容器不丢数据，删这个目录等于把这个数据集的设备群全部解绑。
RELAY_HOST_DATA_DIR=/mnt/cache/appdata/elsewhen-relay/data

# 容器内固定 UID/GID（见 relay/docker/Dockerfile），数据目录必须让它可写。
RELAY_UID=1500
RELAY_GID=1500

# ─── 运行时配额（env，不落库；改了必须重建容器才生效）──────────────────
# 信件账：代码默认 50 MiB（上限 512 MiB）。线上一直显式设成 512 MiB ——
# 手机侧一次 enrollment 快照可能上百 MB，按默认值会反复撞 507。
RELAY_MAILBOX_QUOTA_BYTES=536870912

# blob 数据面账（与信件账**互不占用**，快照挤不掉控制消息）。
# 留空 = 用代码默认值 64 MiB；需要更大时取消下一行注释。
# RELAY_BLOB_QUOTA_BYTES=134217728

# ─── 部署行为 ───────────────────────────────────────────────────────────
# 等 /health 通过的最长秒数
RELAY_HEALTH_TIMEOUT=60

# 远端保留多少个历史镜像（回滚靠它；1 = 只留当前，不建议）
RELAY_KEEP_IMAGES=5

# 部署后是否跑一次契约冒烟（1/0）。会在这台服务器上创建并清空一个临时信箱，
# 数据量级是几 KB 的空库文件，默认关闭。
RELAY_SMOKE=0
