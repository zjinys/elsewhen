# android-app-update 配置 —— 只改这个文件，不要改脚本里的常量。
#
# 取值会被 scripts/*.sh 直接 source（纯 KEY=VALUE，不要写 `export`、
# 不要用空格包围 `=`）。敏感项（私钥路径等）放 config.local.env，它已在 .gitignore。
#
# ⚠ 值里有空格必须加引号。`APK_FLUTTER_CMD=fvm flutter` 这种写法在 shell 里
# 是「以 APK_FLUTTER_CMD=fvm 为环境变量去执行 flutter 命令」——赋值不生效、
# 还真会去跑那条命令（曾经每次 source 都在跑 `flutter help`）。

# ─── 目标设备 ───────────────────────────────────────────────────────────
# 留空 = adb 上只有一个设备时自动用那个；多个设备时会报错并要求你显式指定。
# 有线/无线都可以，填 `adb devices` 里那串序列号本身，不要加引号。
# 例：APK_DEVICE=PEUM00
#     APK_DEVICE=192.168.101.109:39877
#     APK_DEVICE=adb-e475049c-M03BAz._adb-tls-connect._tcp
APK_DEVICE=

# ─── 应用身份 ───────────────────────────────────────────────────────────
# applicationId（ui/android/app/build.gradle.kts 里的 applicationId）。
APK_APP_ID=dev.elsewhen.elsewhen_ui

# 允许覆盖安装的签名证书 SHA-256（apksigner --print-certs 的 Signer #1）。
# 校验理由：`adb install -r` 遇到签名不同的包会以 INSTALL_FAILED_UPDATE_INCOMPATIBLE
# 失败，而报错不告诉你「哪张证书不一样」；先比对再安装，能把「签名不对」
# 从「安装失败」里分出来。多个证书用空格分隔。
# 空 = 跳过该检查（只在首次安装、或明知要换签名时使用）。
APK_EXPECTED_CERT_SHA256=00706741dc04dc8015a95d320112d7f95ba5dc008bb9631443a96fc0cab5b294

# ─── 构建 ───────────────────────────────────────────────────────────────
# 透传给 `scripts/build-apk.sh` 的额外参数，空格分隔。
# 默认空 = release + 仅 arm64-v8a。例：APK_BUILD_ARGS=--debug
APK_BUILD_ARGS=

# flutter 命令（注意引号）。用 fvm 的项目保持默认；没有 fvm 时改成 flutter。
APK_FLUTTER_CMD="fvm flutter"

# 是否总是重新构建（1/0）。0 = 本地已有比 scripts/build-apk.sh 更新的 APK 时跳过构建。
APK_ALWAYS_BUILD=1

# ─── Android SDK（找 apksigner 用）──────────────────────────────────────
# 留空 = 依次试 $ANDROID_HOME / $ANDROID_SDK_ROOT / ~/Android/Sdk / $HOME/Android/sdk。
# 显式指定时写 SDK 根目录（脚本自己去 build-tools/ 里挑版本最高的 apksigner）。
APK_ANDROID_SDK=
